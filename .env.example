PORT=5000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:3000"

# Security
JWT_ACCESS_SECRET="production_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="production_jwt_refresh_secret_super_secure_key_2026"
